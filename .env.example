# Masters Expo 2026 Campaign Command Center - Backend Environment Variables

# Server Network Settings
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb://127.0.0.1:27017/masters_command_center

# JWT Secret Key for Authentication
JWT_SECRET=super_secret_production_jwt_key_masters_expo_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Security & Cookie Settings
COOKIE_SECRET=masters_expo_secure_cookie_key
